# ============================================================
# SPT Hospital HRMS — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Environment ──────────────────────────────────────────────
# Set to 'production' in live deployment to disable /docs, /redoc, /openapi.json
# and enforce strict CORS origin restrictions.
ENV=development

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://spt_user:spt_password@localhost:5432/spt_hrms
SYNC_DATABASE_URL=postgresql://spt_user:spt_password@localhost:5432/spt_hrms

# ── Authentication ───────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-at-least-64-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── File Upload & Cloud Storage (AWS S3) ──────────────────────
# Set STORAGE_BACKEND=s3 to use AWS S3 bucket for attendance PDFs, salary slips, and exports.
# Leave as 'local' to use the local filesystem inside UPLOAD_DIR.
STORAGE_BACKEND=local
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=50

# AWS S3 Settings (required when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=spt-hospital-hrms-storage
AWS_S3_PREFIX=hrms
# AWS_S3_ENDPOINT_URL=http://localhost:4566 # Optional: LocalStack / MinIO
AWS_S3_PRESIGNED_URL_EXPIRES_SECONDS=3600

# ── CORS ────────────────────────────────────────────────────
# In production, restrict strictly to your configured frontend domain(s), e.g. https://hrms.spthospital.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Application ──────────────────────────────────────────────
APP_NAME=SPT Hospital HRMS
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ── Hospital Info (also configurable from Settings page) ─────
HOSPITAL_NAME=SPT Hospital
HOSPITAL_ADDRESS=
HOSPITAL_PHONE=
HOSPITAL_EMAIL=

# ── Redis (for session management / future job queue) ────────
REDIS_URL=redis://localhost:6379/0

# ── Frontend (Next.js) ───────────────────────────────────────
# These go in frontend/.env.local (or your cloud platform environment settings)
# In production, point to your production API domain: e.g. https://api.spthospital.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="SPT Hospital HRMS"
