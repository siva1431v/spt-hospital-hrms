# ============================================================
# SPT Hospital HRMS — Production Environment Variables
# ============================================================
# Copy this to .env on your server: cp .env.production.example .env
# Then edit with your actual values.

# ── Domain ──────────────────────────────────────────────────
# Your domain name (Caddy will auto-provision SSL certificate)
DOMAIN=hrms.yourdomain.com

# ── Database ────────────────────────────────────────────────
POSTGRES_USER=spt_user
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
POSTGRES_DB=spt_hrms

# ── Authentication ──────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_STRING

# ── Storage ─────────────────────────────────────────────────
STORAGE_BACKEND=local
