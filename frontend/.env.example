# SPT Hospital HRMS — Frontend Environment Variables
# Copy to .env.local for local development or set in your cloud deployment platform (e.g. Vercel / Railway).

# URL of the backend API (must point to your deployed backend URL in production)
# Examples:
#   Local: http://localhost:8000/api/v1
#   Production (Render): https://spt-hospital-backend.onrender.com/api/v1
#   Production (Railway): https://backend-production-xxxx.up.railway.app/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Application Name
NEXT_PUBLIC_APP_NAME="SPT Hospital HRMS"
